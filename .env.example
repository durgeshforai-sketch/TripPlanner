# ---- Product ----
NEXT_PUBLIC_APP_NAME=Tripsync

# Demo mode is OPT-IN. Leave this unset and the app uses free, keyless
# OpenStreetMap services, which return real data. Set it to "true" only if you
# want generated sample data instead; it is always labelled in the UI.
NEXT_PUBLIC_DEMO_MODE=false

# ---- Free, keyless services used by default (no configuration needed) ----
# Places / autocomplete : photon.komoot.io + nominatim.openstreetmap.org
# Road routing          : router.project-osrm.org
# Activities            : overpass-api.de
# Maps                  : Leaflet + OpenStreetMap tiles
# Holidays              : date.nager.at (plus a curated Indian calendar)
# Setting the Google keys below swaps the first four for Google's equivalents.

# ---- Supabase (server only) ----
SUPABASE_URL=
# Either name works. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres schema the app owns. Must be exposed in the project's API settings.
SUPABASE_DB_SCHEMA=tripsync

# ---- Google Maps Platform ----
# Browser key: restrict by HTTP referrer, Maps JavaScript API only.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Server key: restrict to Places API (New) + Routes API. Never sent to the browser.
GOOGLE_MAPS_SERVER_KEY=

# ---- Flights ----
DUFFEL_ACCESS_TOKEN=
# Optional alternative provider. Leave blank unless you have working credentials.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# ---- Holidays ----
HOLIDAY_API_BASE_URL=https://date.nager.at/api/v3

# ---- Optional AI explanations ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Deployment ----
# Used to build absolute invite links. Vercel sets VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=
